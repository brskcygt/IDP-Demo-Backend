# Address the HTTP server binds to
HOST=0.0.0.0
# Port the backend listens on. The NSSM service created by ops/bootstrap-windows.ps1
# sets PORT itself and wins over .env; remove it from the service to manage it here.
PORT=8085
# Allowed browser origin for API calls
CORS_ORIGIN=*
# Message shown on the demo page
DEMO_MESSAGE=IDP artifact deployment is working.
